rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Only the user and admins can read the full profile (PII)
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        // Referral lookup: allow reading users who signed up with my referral code
        (resource.data.referredBy != null &&
         resource.data.referredBy == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode)
      );

      // Self-create: user can only create their own doc
      allow create: if request.auth != null && request.auth.uid == userId;

      // Self-update: user can update their own doc, but cannot modify the role field
      // (prevents privilege escalation via direct Firestore API)
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      // Self-delete: user can delete their own doc (for orphaned signup cleanup)
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Admin full access (create, update, delete)
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /leaderboard/{userId} {
      // Public read — anyone can see names, countries, and points
      allow read: if true;

      // Users can upsert their own entry
      allow write: if request.auth != null && request.auth.uid == userId;

      // Admin can write any leaderboard entry (Sync All button)
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /leaderboard_champions/{weekId} {
      // Public read — anyone can see past champions
      allow read: if true;

      // Authenticated users can create champion records (archived during sync)
      allow create: if request.auth != null;

      // Prevent overwrites — champion records are immutable after creation
      allow update, delete: if false;
    }
  }
}
